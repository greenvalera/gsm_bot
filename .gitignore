node_modules
coverage
dist
# NOTE: src/generated/prisma is deliberately COMMITTED, not ignored.
# The `prisma-client` generator emits TypeScript source into src/, which
# `tsc --noEmit` compiles and 18 files import, so a fresh clone typechecks
# without running `npm run db:generate` first. Regenerate it in the SAME
# commit as any prisma/schema.prisma change: `npm run db:generate`.
.env
.env.*
!.env.example

# --- GSD runtime (installed tooling, not source) ---
# Reinstall on a new host with:
#   npx -y @opengsd/gsd-core@1.11.0 --claude --local
# Tracked and intentionally NOT ignored: .claude/CLAUDE.md, .codex/config.toml, .planning/**
.claude/gsd-core/
.claude/agents/
.claude/commands/
.claude/hooks/
.claude/scripts/
.claude/gsd-file-manifest.json
.claude/gsd-install-state.json
.claude/.gsd-profile
.agents/
.codex/agents/
.codex/hooks/
.codex/hooks.json

# --- GSD local session state (per-host, never portable) ---
# per-agent scratch worktrees
.claude/worktrees/
# dispatch-isolation sentinel
.gsd/
# Researcher web-fetch cache: TTL'd JSON keyed by content hash, re-fetched on
# demand. Untracked deliberately -- entries expire (ttl 24h) and carry no value
# across hosts.
.planning/research/.cache/
