.claude/gsd-install-state.json
.claude/.gsd-profile
.agents/
.codex/agents/
.codex/hooks/
.codex/hooks.json

# --- GSD local session state (per-host, never portable) ---
.claude/worktrees/
.gsd/
.planning/research/.cache/
