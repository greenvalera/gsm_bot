generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PlanningAccessPolicy {
  ADMINS_ONLY
  PREVIOUS_PARTICIPANTS
  ANYONE_IN_CHAT
}

enum SetupStep {
  READINESS
}

enum CallbackActionKind {
  START_SETUP
  SETTINGS_EDIT
  ROSTER_REMOVE
  PLANNING
}

/// One participant's answer to one availability round (AVAIL-02).
///
/// A fresh `CREATE TYPE`, so it may be created AND used by the same migration —
/// unlike `ALTER TYPE ... ADD VALUE`, whose new label cannot be referenced until
/// the adding transaction commits, and Prisma applies each migration inside one.
enum ParticipantAvailability {
  AVAILABLE
  UNAVAILABLE
}

/// The round's single durable lifecycle position.
///
/// `BOOKED` is appended LAST and the order is load-bearing twice over:
/// PostgreSQL appends a new label at the end of `enumsortorder`, and
/// `hasExactValues` in `prisma/migrate-deploy.mjs` compares the catalog's labels
/// index by index. A member inserted in the middle would fail the deploy
/// preflight on a correctly migrated database.
enum PlanningRoundStatus {
  DRAFT
  CONFIRMED
  SUPERSEDED
  BOOKED
}

enum PlanningStep {
  DAY
  TIME
  REVIEW
}

enum SettingsField {
  TIMEZONE
  DEFAULT_WEEKDAY
  DEFAULT_START_MINUTE
  DURATION_MINUTES
  DAILY_START_MINUTE
  DAILY_END_MINUTE
  REMINDER_MINUTES
  PLANNING_ACCESS_POLICY
}

model ChatConfiguration {
  chatId               BigInt               @id @map("chat_id")
  timezone             String
  defaultWeekday       Int                  @map("default_weekday")
  defaultStartMinute   Int                  @map("default_start_minute")
  durationMinutes      Int                  @map("duration_minutes")
  dailyStartMinute     Int                  @map("daily_start_minute")
  dailyEndMinute       Int                  @map("daily_end_minute")
  reminderMinutes      Int[]                @map("reminder_minutes")
  planningAccessPolicy PlanningAccessPolicy @default(ADMINS_ONLY) @map("planning_access_policy")
  revision             Int                  @default(1)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("chat_configurations")
}

/// The `/plan_status` cooldown for a chat that has NO draft round to hold one.
///
/// `PlanningRound.lastStatusPostedAt` can only rate-limit a chat that has a
/// round, which leaves the no-round, unconfigured and failed replies — the
/// COMMON state of a chat — completely unrated, and D-15 opens `/plan_status`
/// to every member. This row is what those three branches claim before they
/// speak. Keyed by chat and nothing else: it exists precisely for the case where
/// there is no round to key it to, and it is created on first use rather than
/// with the configuration, because an unconfigured chat needs one too.
model ChatStatusCooldown {
  chatId       BigInt   @id @map("chat_id")
  lastPostedAt DateTime @map("last_posted_at") @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("chat_status_cooldowns")
}

model SetupDraft {
  id                   String                @id @default(cuid())
  chatId               BigInt                @map("chat_id")
  actorUserId          BigInt                @map("actor_user_id")
  step                 SetupStep             @default(READINESS)
  candidateTimezone    String?               @map("candidate_timezone")
  timezone             String?
  defaultWeekday       Int?                  @map("default_weekday")
  defaultStartMinute   Int?                  @map("default_start_minute")
  durationMinutes      Int?                  @map("duration_minutes")
  dailyStartMinute     Int?                  @map("daily_start_minute")
  dailyEndMinute       Int?                  @map("daily_end_minute")
  reminderMinutes      Int[]                 @map("reminder_minutes")
  planningAccessPolicy PlanningAccessPolicy? @map("planning_access_policy")
  expectedRevision     Int                   @default(0) @map("expected_revision")
  expiresAt            DateTime              @map("expires_at") @db.Timestamptz(3)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([chatId, actorUserId])
  @@index([expiresAt])
  @@map("setup_drafts")
}

model SettingsEditDraft {
  id                 String        @id @default(cuid())
  chatId             BigInt        @map("chat_id")
  actorUserId        BigInt        @map("actor_user_id")
  field              SettingsField
  replacementPayload Json?         @map("replacement_payload")
  expectedRevision   Int           @map("expected_revision")
  expiresAt          DateTime      @map("expires_at") @db.Timestamptz(3)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([chatId, actorUserId])
  @@index([expiresAt])
  @@map("settings_edit_drafts")
}

model CallbackAction {
  token       String             @id
  kind        CallbackActionKind
  chatId      BigInt             @map("chat_id")
  actorUserId BigInt             @map("actor_user_id")
  targetId    String?            @map("target_id")
  expiresAt   DateTime           @map("expires_at") @db.Timestamptz(3)
  consumedAt  DateTime?          @map("consumed_at") @db.Timestamptz(3)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([chatId, actorUserId, expiresAt])
  /// Supports retention sweeps that filter by expiry alone.
  @@index([expiresAt])
  @@map("callback_actions")
}

model TelegramUser {
  telegramUserId BigInt           @id @map("telegram_user_id")
  firstName      String?          @map("first_name")
  lastName       String?          @map("last_name")
  username       String?
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships    ChatMembership[]

  @@map("telegram_users")
}

/// One durable rehearsal-planning process for one chat.
///
/// Every wizard value lives here rather than in a grammY session, so a restart
/// resumes the exact step and selection (RELI-01). The schedule columns are a
/// SNAPSHOT taken when the round starts: a concurrent `/settings` edit must not
/// retroactively invalidate a card that is already on screen.
model PlanningRound {
  id                    String              @id @default(cuid())
  chatId                BigInt              @map("chat_id")
  authorUserId          BigInt              @map("author_user_id")
  /// Chat-local Monday of the target week, "YYYY-MM-DD".
  targetWeekStart       String              @map("target_week_start")
  /// Equals `targetWeekStart` while DRAFT; NULL on confirm, abandon or
  /// supersede. PostgreSQL treats NULLs in a unique index as distinct, so many
  /// finished rounds coexist for one week while at most one DRAFT can exist.
  /// `status` and `activeWeekStart` MUST always be changed in one transaction.
  activeWeekStart       String?             @map("active_week_start")
  status                PlanningRoundStatus @default(DRAFT)
  step                  PlanningStep        @default(DAY)
  timezone              String
  durationMinutes       Int                 @map("duration_minutes")
  dailyStartMinute      Int                 @map("daily_start_minute")
  dailyEndMinute        Int                 @map("daily_end_minute")
  /// Civil "YYYY-MM-DD"; never `@db.Date`, which Prisma maps to a JS Date at
  /// UTC midnight and renders as the previous day for a negative-offset chat.
  selectedDate          String?             @map("selected_date")
  selectedStartMinute   Int?                @map("selected_start_minute")
  anchorMessageId       Int?                @map("anchor_message_id")
  startsAt              DateTime?           @map("starts_at") @db.Timestamptz(3)
  endsAt                DateTime?           @map("ends_at") @db.Timestamptz(3)
  confirmedAt           DateTime?           @map("confirmed_at") @db.Timestamptz(3)
  lastActivityAt        DateTime            @map("last_activity_at") @db.Timestamptz(3)
  lastStatusPostedAt    DateTime?           @map("last_status_posted_at") @db.Timestamptz(3)
  /// The AVAIL-07 unanimity claim AND the record of it — one column, never a
  /// claim column beside a separate "was it announced" flag that can disagree.
  /// NULL means the round has never been announced ready to book; the guarded
  /// `updateMany` that sets it from NULL is what makes the announcement
  /// exactly-once under two simultaneous final answers.
  readyAnnouncedAt      DateTime?           @map("ready_announced_at") @db.Timestamptz(3)
  /// D-12 (as amended): the ready-to-book announcement message. NEVER written
  /// with the availability card's id, and `anchorMessageId` is never written
  /// with this one — the card stays live and editable for the whole round.
  announcementMessageId Int?                @map("announcement_message_id")
  /// LIFE-01, as the timestamp DETAIL of `status = BOOKED`, never as the
  /// authority for "is it booked". Nullable with no default, so this migration
  /// never has to reference the new enum label.
  bookedAt              DateTime?           @map("booked_at") @db.Timestamptz(3)
  bookedByUserId        BigInt?             @map("booked_by_user_id")
  revision              Int                 @default(1)
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  participants PlanningParticipant[]

  @@unique([id, chatId])
  @@unique([chatId, activeWeekStart])
  @@index([chatId, status, targetWeekStart])
  @@index([chatId, startsAt])
  @@map("planning_rounds")
}

/// The confirm-time snapshot of the chat's active band roster (D-09 / D-11).
///
/// There is no participant-selection step: the active roster IS the lineup.
/// Phase 3 reads these rows to decide exactly who may answer the availability
/// card, so the snapshot is a durable cross-phase contract.
model PlanningParticipant {
  id             String                   @id @default(cuid())
  roundId        String                   @map("round_id")
  chatId         BigInt                   @map("chat_id")
  telegramUserId BigInt                   @map("telegram_user_id")
  membershipId   String                   @map("membership_id")
  /// This participant's answer (AVAIL-02), NULL until they first tap. The
  /// answer is a MUTABLE VALUE, not an append-only event: D-04 keeps both
  /// buttons live so tapping the other one overwrites this. Deliberately no
  /// `revision` column beside it — the exactly-once property is a
  /// compare-and-set on this value, so there is nothing for a revision to add.
  availability   ParticipantAvailability?
  /// When the current answer was recorded, for Phase 5's follow-up targeting
  /// and for operator forensics.
  answeredAt     DateTime?                @map("answered_at") @db.Timestamptz(3)
  round          PlanningRound            @relation(fields: [roundId, chatId], references: [id, chatId], onDelete: Cascade)
  membership     ChatMembership           @relation(fields: [membershipId, chatId, telegramUserId], references: [id, chatId, telegramUserId], onDelete: Restrict)

  @@unique([roundId, telegramUserId])
  @@index([telegramUserId])
  @@map("planning_participants")
}

model ChatMembership {
  id                   String                @id @default(cuid())
  chatId               BigInt                @map("chat_id")
  telegramUserId       BigInt                @map("telegram_user_id")
  activeAt             DateTime?             @default(now()) @map("active_at") @db.Timestamptz(3)
  deactivatedAt        DateTime?             @map("deactivated_at") @db.Timestamptz(3)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  telegramUser         TelegramUser          @relation(fields: [telegramUserId], references: [telegramUserId], onDelete: Restrict)
  planningParticipants PlanningParticipant[]

  @@unique([id, chatId, telegramUserId])
  @@unique([chatId, telegramUserId])
  @@index([chatId, activeAt])
  @@map("chat_memberships")
}
